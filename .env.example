# Autonomous Transactive Microgrid Energy Exchange (.env.example)

# Security (Required: Generate a strong secret: openssl rand -hex 32)
MGX_JWT_SECRET=replace-with-a-secure-32-byte-hex-secret-in-production
MGX_JWT_ALGORITHM=HS256
MGX_ACCESS_TOKEN_MINUTES=120

# Database & Cache
# Production / Docker Compose:
MGX_DATABASE_URL=postgresql+asyncpg://mgx:mgx_secret_password@postgres:5432/mgx_db
MGX_REDIS_URL=redis://redis:6379/0

# Seed Admin Credentials
MGX_ADMIN_PASSWORD=change-me-admin-secure-pass

# Trading & Risk Controls
MGX_RATE_LIMIT_PER_MINUTE=120
MGX_COLLATERAL_FRACTION=1.0
MGX_PENALTY_MULTIPLIER=1.5
MGX_UNCERTAINTY_RESERVE_FACTOR=1.0
MGX_OPERATIONAL_RESERVE_FRACTION=0.08
MGX_SYSTEM_RESERVE_MARGIN_FRACTION=0.10
MGX_MIN_RELIABILITY_FOR_TRADING=0.50

# Carbon Factors (kg CO2 / kWh)
MGX_GRID_CARBON_INTENSITY_KG_PER_KWH=0.42
MGX_RENEWABLE_CARBON_INTENSITY_KG_PER_KWH=0.015
